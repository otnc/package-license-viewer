{
  "name": "package-license-viewer-monorepo",
  "private": true,
  "version": "0.5.0",
  "description": "Shows dependency license metadata inline in package.json, deno.json, Cargo.toml and moon.mod.",
  "publisher": "otoneko1102",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "compile": "npm run compile:lsp && npm run compile:vscode",
    "compile:lsp": "npm run compile -w @plv/lsp-server",
    "watch:lsp": "npm run watch -w @plv/lsp-server",
    "compile:vscode": "npm run compile -w package-license-viewer",
    "watch:vscode": "npm run watch -w package-license-viewer",
    "check-types": "npm run check-types --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "npm run test:integration -w package-license-viewer",
    "package": "npm run package -w package-license-viewer",
    "publish": "npm run publish -w package-license-viewer",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:build": "kiritan build",
    "docs:check": "kiritan check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "git-cliff": "^2.13.1",
    "globals": "^17.12.0",
    "kiritan": "^0.4.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
